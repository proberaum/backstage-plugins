{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 20,
  "postUpdateOptions": [
    "yarnDedupeHighest"
  ],
  "packageRules": [
    {
      "enabled": false,
      "matchPackagePatterns": ["^@material-ui/"],
      "matchUpdateTypes": ["replacement"]
    }
  ]
}
